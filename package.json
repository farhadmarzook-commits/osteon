{
  "name": "osteon",
  "version": "1.4.1",
  "description": "Anki-style flashcards inside Obsidian: notes and cards in one place, FSRS scheduling, real card backs.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "test": "TZ=UTC vitest run",
    "dist": "npm run build && mkdir -p dist && cp main.js manifest.json styles.css dist/"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "fflate": "^0.8.3",
    "fzstd": "^0.1.1",
    "sql.js": "^1.14.2",
    "ts-fsrs": "^5.4.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/sql.js": "^1.4.11",
    "esbuild": "^0.28.2",
    "obsidian": "^1.13.1",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
